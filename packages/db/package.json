{
  "name": "@glimpse/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor",
    "stop": "supabase stop",
    "reset": "supabase db reset",
    "status": "supabase status -o env",
    "gen:types": "supabase gen types typescript --local --schema public > src/database.types.ts",
    "test": "node --test test/rls.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "hosted-sql": "node scripts-hosted-sql.mjs"
  },
  "devDependencies": {
    "supabase": "^2.118.0",
    "typescript": "5.9.3",
    "postgres": "^3.4.9"
  }
}
