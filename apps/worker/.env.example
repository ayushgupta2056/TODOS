# Postgres (local Supabase: `pnpm db:start`; production: Supabase "Session pooler" connection string)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# S3-compatible storage (local MinIO from infra/docker-compose.yml; production: Cloudflare R2)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=glimpse
S3_ACCESS_KEY_ID=glimpse
S3_SECRET_ACCESS_KEY=glimpse-secret

# Shared secret between apps/web and the worker's /v1/selfie/embed endpoint
WORKER_TOKEN=dev-worker-token

# Tuning (defaults shown; see docs/phase-2.md)
# CONCURRENCY=<cpu count>
# MATCH_THRESHOLD=0.42
# CLUSTER_THRESHOLD=0.55
# CLUSTER_MATCH_THRESHOLD=0.55
# DET_SCORE_THRESHOLD=0.7
# MIN_EYE_DISTANCE_PX=20
# MIN_BLUR_VARIANCE=35
# TILING=auto
