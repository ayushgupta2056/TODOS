# ---- App ----
APP_URL=http://localhost:3000

# ---- Supabase (local values printed by `pnpm db:start`) ----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from `supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<service_role key from `supabase status`>
# Show the "Continue with Google" button (configure the provider in Supabase first)
NEXT_PUBLIC_GOOGLE_AUTH=false

# ---- Object storage: Cloudflare R2 in prod, MinIO locally ----
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=glimpse
S3_ACCESS_KEY_ID=glimpse
S3_SECRET_ACCESS_KEY=glimpse-secret

# ---- Face worker ----
WORKER_URL=http://127.0.0.1:8787
WORKER_TOKEN=dev-worker-token
MATCH_THRESHOLD=0.42
CLUSTER_MATCH_THRESHOLD=0.55

# ---- Guest sessions (HMAC for cookies). `openssl rand -hex 32` ----
GUEST_SECRET=dev-guest-secret-change-me-32-chars-min

# ---- Optional (the app works without these) ----
# RESEND_API_KEY=
# EMAIL_FROM="Glimpse <hello@example.com>"
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_STARTER=
# RAZORPAY_PLAN_PRO=
# RAZORPAY_PLAN_STUDIO=
